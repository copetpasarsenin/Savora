# SavePlate Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001

# Database Configuration
# IMPORTANT: main.go currently requires individual DB_* variables (Method 2)
# Seeder (cmd/seed/main.go) supports both methods with DATABASE_URL as priority

# Method 1: Using DATABASE_URL (for seeder, or future main.go refactor)
# DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Method 2: Using individual variables (REQUIRED for current main.go)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=savora

# Supabase Storage Configuration
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_BUCKET_NAME=savora_img

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production

# Xendit Payment Gateway (Sandbox Mode)
# Get from: Xendit Dashboard → Settings → Developers → API Keys / Callbacks
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_CALLBACK_TOKEN=your-xendit-callback-token-here
PAYMENT_EXPIRY_SECONDS=900
FRONTEND_BASE_URL=http://localhost:3000
